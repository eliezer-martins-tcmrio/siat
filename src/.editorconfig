root = true

[*.{cql,sql}]
indent_style = tab
indent_size = tab
tab_width = 4

[*.{appxmanifest,asax,ascx,aspx,axaml,axml,config,cs,cshtml,csproj,dbml,discomap,dtd,htm,html,jsproj,lsproj,master,njsproj,nuspec,paml,proj,props,razor,resw,resx,skin,StyleCop,targets,tasks,vb,vbproj,xaml,xamlx,xml,xoml,xsd}]
indent_style = space
indent_size = 4
tab_width = 4

[*.cs]

#########################
# Regras Globais, para qualquer projeto
#########################

# Nós temos testes de API que só são ligados quando necessários. Por isso esse suppress.
dotnet_diagnostic.xunit1004.severity = none

