<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Tcmrj.Autenticacao.AspNetCore.Oidc" Version="196.1.1" />
    <PackageReference Include="Tcmrj.Autorizacao.App" Version="196.1.1" />
    <!-- O Tcmrj.UserManager.Infra.dll embutido no Tcmrj.Autorizacao.App referencia o Tcmrj.Auditoria.EF, mas o nuspec não declara a dependência. -->
    <PackageReference Include="Tcmrj.Auditoria.EF" Version="140.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Tcmrj.CoreLib.DBLog.AspNetCore" Version="187.2.3" />
    <PackageReference Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- Eleva a transitiva 4.61.0 das bibliotecas do UserManager, com vulnerabilidade conhecida (GHSA-m5vv-6r4h-3vj9). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lista fechada de servidores, lida com reloadOnChange (R6); vai junto na saída e na publicação. -->
    <Content Update="servidores.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tcmrj.Siat.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tcmrj.Siat.App\Tcmrj.Siat.App.csproj" />
    <ProjectReference Include="..\Tcmrj.Siat.Domain\Tcmrj.Siat.Domain.csproj" />
    <ProjectReference Include="..\Tcmrj.Siat.Infra\Tcmrj.Siat.Infra.csproj" />
  </ItemGroup>

</Project>
