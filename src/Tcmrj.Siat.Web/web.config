<?xml version="1.0" encoding="utf-8"?>
<!--
  PROTÓTIPO (features/prototipo_login_rede): modo misto no IIS. Anônimo e Windows ficam ligados; quem exige o usuário
  é a fallback policy da aplicação (AuthenticationConfiguration), que responde com o desafio Negotiate. Assim
  /saude e os arquivos estáticos continuam anônimos, e a regra fica no código.
  A publicação acrescenta aqui o handler do ASP.NET Core Module; o deploy (asi_builds) só aplica o XDT do ambiente.
  No servidor: o recurso "Autenticação do Windows" do IIS precisa estar instalado e a seção windowsAuthentication
  desbloqueada só para este aplicativo; sem isso o IIS responde 500.19.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="true" />
          <windowsAuthentication enabled="true">
            <providers>
              <clear />
              <add value="Negotiate" />
              <add value="NTLM" />
            </providers>
          </windowsAuthentication>
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
