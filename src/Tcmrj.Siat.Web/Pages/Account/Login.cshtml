@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Mvc
@using Tcmrj.Autenticacao.AspNetCore.Oidc

@* Challenge no SIA (esquema "oidc"). Só aceita returnUrl local, para o login não virar redirecionamento aberto. *@
@functions {
    public ChallengeResult OnGet(string returnUrl = "/")
        => Challenge(
            new AuthenticationProperties { RedirectUri = Url.IsLocalUrl(returnUrl) ? returnUrl : "/" },
            TcmrjOidcDefaults.OidcScheme);
}
