@page "/consultas/mailqueue"
@attribute [Authorize]
@implements IDisposable
@using CSharpFunctionalExtensions
@using FluentValidation
@using NetDevPack.SimpleMediator
@using Tcmrj.Siat.App.Web.Features.Servidores
@using Tcmrj.Siat.App.Web.Validators
@using Tcmrj.Siat.App.Web.ViewModels.MailQueue
@using Tcmrj.Siat.Domain.Models
@using Tcmrj.Siat.Web.Services
@using Servicos = Tcmrj.Siat.App.Web.Services
@using ExportarMailQueue = Tcmrj.Siat.App.Web.Features.MailQueue.Exportar
@using ListarSmtpsMailQueue = Tcmrj.Siat.App.Web.Features.MailQueue.ListarSmtps
@using PesquisarMailQueue = Tcmrj.Siat.App.Web.Features.MailQueue.Pesquisar
@inject IAutorizacaoConsultaService AutorizacaoConsulta
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IInteracao Interacao
@inject IValidator<PesquisarMailQueue.Query> Validador
@inject TimeProvider Relogio
@inject IJSRuntime JS

@* Consultas › MailQueue (história 1; design/mailqueue.html).
   - Acesso: no OnInitializedAsync, a política do módulo (a mesma em DSV, HML e PRD); sem ela, AcessoNegado. Cada consulta é
     autorizada de novo no servidor pela feature (R4).
   - URL: servidor, smtp, texto, qtd e sel ([SupplyParameterFromQuery]). Abrir a URL refaz a consulta; consultar grava a
     URL com Navegacao.MailQueue (replace: false); abrir ou fechar uma linha troca só o sel (replace: true).
   - Ao escolher o servidor, a lista de SMTPs e a consulta rodam em paralelo.
   - Estados Ociosa, Consultando, ComResultado e ComErro (data-model), no ControleConsulta: uma consulta por vez, cada
     uma com o seu CancellationTokenSource, que chega ao SqlClient; a nova cancela a anterior e só a última é aplicada.
   - História 4: depois de 1 s, tempo decorrido e Cancelar (EstadoCarregando); cancelar volta ao resultado anterior
     (e à URL dele). Filtro local (FiltroLocal) sobre os itens carregados. Exportar baixa o HTML autocontido montado
     pela feature Exportar, que autoriza de novo no servidor e registra a exportação; o download é pelo siat.js. *@

@if (acesso is null)
{
    <PageTitle>MailQueue · SIAT</PageTitle>
}
else if (acesso == false)
{
    <AcessoNegado Mensagem="Você não tem acesso à MailQueue" Recurso="@Modulo.MailQueue.Politica()" />
}
else
{
    @if (ServidorEscolhido is { } contexto)
    {
        <FaixaContexto Servidor="contexto" Modulo="MailQueue" />
    }

    <CabecalhoPagina Titulo="MailQueue" Descricao="E-mails enfileirados pelos sistemas, do mais recente para o mais antigo.">
        <Status>
            <span class="@ClasseDoStatus" role="status">@StatusDaLeitura</span>
        </Status>
    </CabecalhoPagina>

    <form class="painel filtros" @onsubmit="AoConsultarAsync" novalidate aria-label="Filtros da MailQueue">
        <SeletorServidor Grupos="grupos" Valor="@filtro.Servidor" ValorChanged="AoEscolherServidorAsync" Id="servidor" />
        @MensagemDoCampo(nameof(PesquisarMailQueue.Query.Servidor), "servidor-erro")

        <div class="campo">
            <label for="smtp">SMTP</label>
            <SeletorPesquisavel Id="smtp" Rotulo="SMTP" OpcaoVazia="Todos os SMTPs" Placeholder="Id ou descrição do SMTP"
                                Opcoes="OpcoesDeSmtp" Valor="@filtro.Smtp" ValorChanged="AoMudarSmtp" Ocupado="carregandoSmtps"
                                Invalido="@(Invalido(nameof(PesquisarMailQueue.Query.SmtpId)) is not null)"
                                DescritoPor="@Descrito(nameof(PesquisarMailQueue.Query.SmtpId), "smtp-erro")" />
            @MensagemDoCampo(nameof(PesquisarMailQueue.Query.SmtpId), "smtp-erro")
        </div>

        <div class="campo largo">
            <label for="texto">Buscar no banco</label>
            <input id="texto" type="search" placeholder="Assunto, corpo, destinatário ou MessageId" autocomplete="off"
                   @bind="filtro.Texto" @bind:event="oninput"
                   aria-invalid="@Invalido(nameof(PesquisarMailQueue.Query.Texto))" aria-describedby="@Descrito(nameof(PesquisarMailQueue.Query.Texto), "texto-erro")" />
            @MensagemDoCampo(nameof(PesquisarMailQueue.Query.Texto), "texto-erro")
        </div>

        <div class="campo curto">
            <label for="qtd">Quantidade</label>
            <input id="qtd" inputmode="numeric" autocomplete="off" @bind="filtro.Quantidade" @bind:event="oninput"
                   aria-invalid="@Invalido(nameof(PesquisarMailQueue.Query.Quantidade))" aria-describedby="@Descrito(nameof(PesquisarMailQueue.Query.Quantidade), "qtd-erro")" />
            @MensagemDoCampo(nameof(PesquisarMailQueue.Query.Quantidade), "qtd-erro")
        </div>

        <button type="submit" class="botao" id="consultar">Consultar</button>
    </form>

    @if (!smtps.Disponivel)
    {
        <Aviso Titulo="@Mensagens.SmtpsIndisponiveisTitulo">@smtps.Aviso</Aviso>
    }

    <section class="painel" aria-label="Resultados">
        @if (consultas.Estado == Servicos.EstadoConsulta.Consultando)
        {
            <EstadoCarregando Mensagem="@($"Consultando {servidorEmConsulta}…")" Linhas="@(consultas.Resultado is null ? 6 : 0)"
                              Inicio="consultas.InicioAtual" AoCancelar="Cancelar" />
        }
        else if (consultas.Estado == Servicos.EstadoConsulta.ComErro && consultas.Erro is { } erro)
        {
            @if (erro.Code == Erros.Consultas.CodigoAcessoNegado)
            {
                <EstadoErro Titulo="Acesso negado" Motivo="@erro.Message"
                            Orientacao="@($"Nenhum dado foi consultado. Para consultar, peça o recurso {RecursoNegado} no UserManager.")" />
            }
            else if (erro.Code == Erros.Consultas.CodigoServidorNaoEncontrado)
            {
                <EstadoErro Titulo="Servidor não encontrado na lista" Orientacao="Escolha um servidor no seletor." />
            }
            else
            {
                <EstadoErro Servidor="@servidorComErro" Motivo="@erro.Message" AoTentarDeNovo="TentarDeNovoAsync" />
            }
        }

        @if (consultas.Resultado is { } resultado)
        {
            <FiltroLocal TItem="MensagemVM" Itens="resultado.Itens" TextoDe="TextoDaMensagem" @bind-Texto="filtroLocal" Unidade="e-mails">
                <Acoes>
                    @if (erroExportacao is not null)
                    {
                        <span class="status falha" role="alert">@erroExportacao</span>
                    }
                    <button type="button" class="botao secundario pequeno empurra" id="exportar" title="Baixa um arquivo HTML que abre sem o SIAT"
                            disabled="@(resultado.Itens.Count == 0 || exportando)" @onclick="ExportarAsync">
                        <LucideIcon Name="download" Size="14" aria-hidden="true" focusable="false" />
                        Exportar HTML
                    </button>
                </Acoes>
                <ChildContent Context="visiveis">
                    @if (resultado.Itens.Count == 0)
                    {
                        <EstadoVazio Titulo="Nenhum e-mail encontrado" Mensagem="@DescricaoDoVazio"
                                     TemFiltros="@(filtroDoResultado?.TemFiltros == true)" AoRemoverFiltros="RemoverFiltrosAsync" />
                    }
                    else if (visiveis.Count == 0)
                    {
                        <EstadoVazio Titulo="Nenhum e-mail carregado corresponde ao filtro"
                                     Mensagem="@($"Nenhum dos {resultado.Itens.Count} e-mails carregados contém \"{filtroLocal?.Trim()}\".")" />
                    }
                    else
                    {
                        <ListaExpansivel TItem="MensagemVM" Itens="visiveis" Chave="m => m.MessageId" Selecionado="@selecionado"
                                         SelecionadoChanged="AoSelecionar" AoAbrir="AoAbrir" Rotulo="E-mails" IdBase="mensagens"
                                         Colunas="16px 84px 52px minmax(0, 1fr) 230px 104px" ColunasEstreito="16px 84px 52px minmax(0, 1fr) 92px">
                            <Cabecalho>
                                <span>Situação</span><span>SMTP</span><span>Assunto</span><span class="opc">Para</span><span class="direita">Postado</span>
                            </Cabecalho>
                            <Linha Context="mensagem">
                                <span><span class="pilula @mensagem.SituacaoClasse">@mensagem.SituacaoRotulo</span></span>
                                <span class="cel-suave num" title="@RotuloDoSmtp(mensagem)">@if (mensagem.SmtpTexto is { } smtpId){@smtpId}else{<span class="suave">—</span>}</span>
                                <span class="cel-texto">@if (mensagem.TemAssunto){@mensagem.Assunto}else{<span class="suave">@MensagemVM.SemAssunto</span>}</span>
                                <span class="cel-suave opc">@if (mensagem.PrimeiroDestinatario is { } primeiro){@primeiro@if (mensagem.DemaisDestinatarios > 0){<text> </text><span class="suave">+@mensagem.DemaisDestinatarios</span>}}else{<span class="suave">@MensagemEnfileirada.SemDestinatarios</span>}</span>
                                <span class="cel-suave direita num" title="@mensagem.PostadoEmCompleto">@mensagem.PostadoEmRelativo</span>
                            </Linha>
                            <Detalhe Context="mensagem">
                                <dl class="campos">
                                    <dt>Assunto</dt>
                                    <dd>@if (mensagem.TemAssunto){@mensagem.Assunto}else{<span class="suave">@MensagemVM.SemAssunto</span>}</dd>
                                    <dt>Para</dt>
                                    <dd>@if (mensagem.ListaDestinatarios.Count > 0){@mensagem.Destinatarios}else{<span class="suave">@MensagemEnfileirada.SemDestinatarios</span>}</dd>
                                    <dt>SMTP</dt>
                                    <dd class="num">@if (RotuloDoSmtp(mensagem) is { } rotuloSmtp){@rotuloSmtp}else{<span class="suave">não informado</span>}</dd>
                                    <dt>Situação</dt>
                                    <dd><span class="pilula @mensagem.SituacaoClasse">@mensagem.SituacaoDescricao</span></dd>
                                    <dt>Postado em</dt>
                                    <dd class="num">@mensagem.PostadoEmCompleto</dd>
                                    <dt>Enviar após</dt>
                                    <dd class="num">@if (mensagem.EnviarAposTexto is { } enviarApos){@enviarApos}else{<span class="suave">não informado</span>}</dd>
                                    <dt>Data de envio</dt>
                                    <dd class="num">@if (mensagem.DataEnvioTexto is { } dataEnvio){@dataEnvio}else{<span class="suave">@MensagemVM.NaoEnviado</span>}</dd>
                                    <dt>MessageId</dt>
                                    <dd><span class="mono">@mensagem.MessageId</span> <BotaoCopiar Texto="@mensagem.MessageId" Rotulo="MessageId" /></dd>
                                </dl>
                                <div>
                                    <span class="secao-titulo">Corpo</span>
                                    <CorpoEmail Corpo="@mensagem.Corpo" EhHtml="@mensagem.EhHtml" />
                                </div>
                            </Detalhe>
                        </ListaExpansivel>
                    }
                </ChildContent>
            </FiltroLocal>
        }
        else if (consultas.Estado is Servicos.EstadoConsulta.Ociosa)
        {
            <EstadoVazio Titulo="Escolha o servidor"
                         Mensagem="Os e-mails mais recentes aparecem aqui depois da consulta. O SMTP e o texto são opcionais." />
        }
    </section>

    <footer class="rodape">
        <span>Fonte: banco <span class="mono">MailQueue</span> do servidor escolhido, lido pela conta de serviço somente de leitura.</span>
    </footer>
}

@code {
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");

    // Texto do filtro local: assunto, destinatários, MessageId e corpo sem tags.
    private static readonly Func<MensagemVM, string?> TextoDaMensagem = m => m.TextoBusca;

    [SupplyParameterFromQuery(Name = Navegacao.ParametroServidor)]
    public string? ServidorParametro { get; set; }

    [SupplyParameterFromQuery(Name = Navegacao.ParametroSmtp)]
    public string? SmtpParametro { get; set; }

    [SupplyParameterFromQuery(Name = Navegacao.ParametroTexto)]
    public string? TextoParametro { get; set; }

    [SupplyParameterFromQuery(Name = Navegacao.ParametroQuantidade)]
    public string? QuantidadeParametro { get; set; }

    [SupplyParameterFromQuery(Name = Navegacao.ParametroSelecionado)]
    public string? SelecionadoParametro { get; set; }

    private bool? acesso;
    private bool descartada;
    private IReadOnlyList<GrupoServidoresVM> grupos = [];

    // Formulário e validação por campo.
    private FiltroMailQueueVM filtro = new();
    private IReadOnlyDictionary<string, string> errosCampo = new Dictionary<string, string>();

    // URL já aplicada: a bruta (para ignorar renderizações sem mudança) e a normalizada (para não refazer a consulta
    // quando a URL muda só pelo sel ou pela forma de escrever os mesmos filtros).
    private string? ultimaUrl;
    private string? chaveAplicada;

    // Lista de SMTPs do servidor escolhido.
    private ListaSmtpsVM smtps = ListaSmtpsVM.Vazia;
    private string? servidorDosSmtps;
    private bool carregandoSmtps;
    private CancellationTokenSource? cancelamentoSmtps;

    // Consulta: estado, resultado e cancelamento (um CancellationTokenSource por consulta) no ControleConsulta.
    private Servicos.ControleConsulta<ResultadoConsultaVM<MensagemVM>> consultas = default!;
    private string? servidorEmConsulta;
    private FiltroMailQueueVM? filtroConsultado;
    private FiltroMailQueueVM? filtroDoResultado;
    private string? servidorComErro;
    private string? selecionado;

    // Filtro local sobre os itens carregados e exportação.
    private string? filtroLocal;
    private bool exportando;
    private string? erroExportacao;

    private ServidorVM? ServidorEscolhido =>
        grupos.SelectMany(g => g.Servidores).FirstOrDefault(s => string.Equals(s.Chave, filtro.Servidor, StringComparison.Ordinal));

    private static string RecursoNegado => Modulo.MailQueue.Politica();

    private string? StatusDaLeitura => consultas.Estado switch
    {
        Servicos.EstadoConsulta.Consultando => null,
        _ when consultas.Cancelada =>
            $"Consulta cancelada após {consultas.Duracao.TotalSeconds.ToString("0.0", PtBr)} s · " +
            (consultas.Resultado is null ? "nenhum resultado anterior" : "mostrando o resultado anterior"),
        _ when consultas.Resultado is { } resultado =>
            $"{Servicos.FiltroLocal.Quantidade(resultado.Itens.Count, "e-mails")} · {consultas.Duracao.TotalSeconds.ToString("0.0", PtBr)} s · consultado às {resultado.ConsultadoEm.ToLocalTime().ToString("HH:mm", PtBr)}",
        _ => null,
    };

    private string ClasseDoStatus =>
        consultas.Cancelada && consultas.Estado != Servicos.EstadoConsulta.Consultando ? "status alerta" : "status";

    private string DescricaoDoVazio
    {
        get
        {
            var smtp = filtroDoResultado?.SmtpNumerico is int id ? smtps.RotuloDe(id) : "Todos os SMTPs";
            var texto = filtroDoResultado?.TextoAparado is { } t ? $", contendo \"{t}\"" : string.Empty;
            return $"{smtp}{texto}, em {consultas.Resultado?.Servidor.Nome}.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        consultas = new(Relogio);
        acesso = await AutorizacaoConsulta.PodeAcessarModuloAsync(Modulo.MailQueue);
        if (acesso == true)
        {
            grupos = await Mediator.Send(new ListarPermitidos.Query(Modulo.MailQueue), CancellationToken.None);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (acesso != true)
        {
            return;
        }

        selecionado = Vazio(SelecionadoParametro);

        var url = string.Join('\u001f', ServidorParametro, SmtpParametro, TextoParametro, QuantidadeParametro);
        if (url == ultimaUrl)
        {
            return;
        }

        ultimaUrl = url;
        var daUrl = new FiltroMailQueueVM
        {
            Servidor = Vazio(ServidorParametro),
            Smtp = Vazio(SmtpParametro),
            Texto = Vazio(TextoParametro),
            Quantidade = Vazio(QuantidadeParametro) ?? Quantidade.Padrao.ToString(CultureInfo.InvariantCulture),
        };

        var chave = ChaveDe(daUrl);
        if (chave == chaveAplicada)
        {
            return;
        }

        chaveAplicada = chave;
        filtro = daUrl;
        if (daUrl.Servidor is null)
        {
            return;
        }

        // A lista de SMTPs e a consulta da URL rodam juntas.
        await Task.WhenAll(CarregarSmtpsSeMudouAsync(daUrl.Servidor), ConsultarAsync(daUrl.Copiar()));
    }

    private async Task AoConsultarAsync()
    {
        var consulta = filtro.Copiar();
        selecionado = null;

        var tarefas = new List<Task>(2);
        if (consulta.Servidor is not null)
        {
            tarefas.Add(CarregarSmtpsSeMudouAsync(consulta.Servidor));
        }

        if (Validar(consulta))
        {
            chaveAplicada = ChaveDe(consulta);
            Navigation.NavigateTo(UrlDe(consulta, null), replace: false);
            tarefas.Add(ConsultarAsync(consulta));
        }

        await Task.WhenAll(tarefas);
    }

    // Escolher o servidor já consulta. Os SMTPs são do servidor: a escolha anterior não vale mais.
    private Task AoEscolherServidorAsync(string? chave)
    {
        filtro.Servidor = chave;
        filtro.Smtp = null;
        return chave is null ? Task.CompletedTask : AoConsultarAsync();
    }

    private void AoMudarSmtp(string? smtp) => filtro.Smtp = Vazio(smtp);

    // Opções do seletor de SMTP; um SMTP da URL que não está na lista entra no topo, com o rótulo "SMTP N".
    private IReadOnlyList<SeletorPesquisavel.Opcao> OpcoesDeSmtp
    {
        get
        {
            var opcoes = smtps.Itens
                .Select(s => new SeletorPesquisavel.Opcao(s.SmtpId.ToString(CultureInfo.InvariantCulture), s.Rotulo))
                .ToList();
            if (filtro.SmtpNumerico is int foraDaLista && !smtps.Itens.Any(s => s.SmtpId == foraDaLista))
            {
                opcoes.Insert(0, new SeletorPesquisavel.Opcao(foraDaLista.ToString(CultureInfo.InvariantCulture), smtps.RotuloDe(foraDaLista)));
            }

            return opcoes;
        }
    }

    private Task TentarDeNovoAsync() => filtroConsultado is null ? Task.CompletedTask : RefazerAsync(filtroConsultado.Copiar());

    private Task RemoverFiltrosAsync()
    {
        filtro.Smtp = null;
        filtro.Texto = null;
        return AoConsultarAsync();
    }

    private Task RefazerAsync(FiltroMailQueueVM consulta)
    {
        filtro = consulta;
        return AoConsultarAsync();
    }

    private bool Validar(FiltroMailQueueVM consulta)
    {
        var erros = Validador.Validate(ParaQuery(consulta)).Errors
            .GroupBy(e => e.PropertyName, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().ErrorMessage, StringComparer.Ordinal);

        // O SmtpId da query já é número: um "smtp" não numérico (só pela URL) é recusado aqui, sem consulta.
        if (!string.IsNullOrWhiteSpace(consulta.Smtp) && consulta.SmtpNumerico is null)
        {
            erros[nameof(PesquisarMailQueue.Query.SmtpId)] = Mensagens.SmtpInvalido;
        }

        errosCampo = erros;
        return erros.Count == 0;
    }

    private async Task ConsultarAsync(FiltroMailQueueVM consulta)
    {
        if (!Validar(consulta))
        {
            return;
        }

        if (descartada)
        {
            return;
        }

        Interacao.Interagir();

        // Uma consulta por vez: a nova cancela a anterior, que é interrompida no banco e descartada aqui.
        var tentativa = consultas.Iniciar();
        filtroConsultado = consulta;
        servidorEmConsulta = NomeDoServidor(consulta.Servidor);
        StateHasChanged();

        Result<ResultadoConsultaVM<MensagemVM>, Erro> obtido;
        try
        {
            obtido = await Mediator.Send(ParaQuery(consulta), tentativa.Token);
        }
        catch (OperationCanceledException)
        {
            obtido = Erros.Consultas.Cancelada;
        }

        // Vale só a última: uma consulta substituída (ou a página fechada) não mexe na tela.
        if (!consultas.Concluir(tentativa, obtido))
        {
            return;
        }

        if (obtido.IsSuccess)
        {
            filtroDoResultado = consulta;
            erroExportacao = null;
        }
        else if (consultas.Cancelada)
        {
            // Cancelar volta ao estado anterior: o resultado anterior continua na tela, e a URL volta a ser a dele.
            RestaurarUrlDoResultado();
        }
        else
        {
            servidorComErro = servidorEmConsulta;
        }

        if (consultas.Resultado is null)
        {
            filtroDoResultado = null;
        }
    }

    private void Cancelar()
    {
        Interacao.Interagir();
        consultas.Cancelar();
    }

    private void RestaurarUrlDoResultado()
    {
        if (filtroDoResultado is null)
        {
            return;
        }

        chaveAplicada = ChaveDe(filtroDoResultado);
        Navigation.NavigateTo(UrlDe(filtroDoResultado, selecionado), replace: true);
    }

    // Exporta os itens já carregados (não consulta de novo). A feature autoriza de novo no servidor e registra.
    private async Task ExportarAsync()
    {
        if (exportando || consultas.Resultado is not { } atual || filtroDoResultado is not { } usado)
        {
            return;
        }

        exportando = true;
        erroExportacao = null;
        Interacao.Interagir();
        try
        {
            var obtido = await Mediator.Send(
                new ExportarMailQueue.Query(
                    atual.Servidor.Chave,
                    usado.SmtpNumerico,
                    usado.SmtpNumerico is int smtp ? smtps.RotuloDe(smtp) : null,
                    usado.TextoAparado,
                    usado.QuantidadeNumerica ?? Quantidade.Padrao,
                    filtroLocal,
                    atual.Itens),
                CancellationToken.None);

            if (obtido.IsFailure)
            {
                erroExportacao = $"Exportação não realizada: {obtido.Error.Message}";
                return;
            }

            await BaixarAsync(obtido.Value);
        }
        finally
        {
            exportando = false;
        }
    }

    private async Task BaixarAsync(ArquivoExportado arquivo)
    {
        try
        {
            using var conteudo = new MemoryStream(arquivo.Conteudo, writable: false);
            using var referencia = new DotNetStreamReference(conteudo);
            await JS.InvokeVoidAsync("siat.baixarArquivo", arquivo.Nome, referencia, ArquivoExportado.TipoConteudo);
        }
        catch (JSDisconnectedException)
        {
            // A página foi fechada durante o download: nada a mostrar.
        }
        catch (JSException ex)
        {
            erroExportacao = $"Não foi possível baixar o arquivo: {ex.Message}";
        }
    }

    private async Task CarregarSmtpsSeMudouAsync(string servidor)
    {
        if (string.Equals(servidor, servidorDosSmtps, StringComparison.Ordinal))
        {
            return;
        }

        cancelamentoSmtps?.Cancel();
        using var cancelamento = new CancellationTokenSource();
        cancelamentoSmtps = cancelamento;
        servidorDosSmtps = servidor;
        carregandoSmtps = true;
        smtps = ListaSmtpsVM.Vazia;

        Result<ListaSmtpsVM, Erro> obtidos;
        try
        {
            obtidos = await Mediator.Send(new ListarSmtpsMailQueue.Query(servidor), cancelamento.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (descartada || !ReferenceEquals(cancelamentoSmtps, cancelamento))
        {
            return;
        }

        cancelamentoSmtps = null;
        carregandoSmtps = false;

        // Negado ou cancelado: sem lista (a consulta mostra o motivo). Indisponível: vazia com aviso.
        smtps = obtidos.IsSuccess ? obtidos.Value : ListaSmtpsVM.Vazia;
        StateHasChanged();
    }

    private void AoSelecionar(string? chave)
    {
        selecionado = chave;
        if (filtroConsultado is not null)
        {
            Navigation.NavigateTo(UrlDe(filtroConsultado, chave), replace: true);
        }
    }

    private void AoAbrir(MensagemVM mensagem) => Interacao.Interagir();

    private string? Invalido(string campo) => errosCampo.ContainsKey(campo) ? "true" : null;

    private string? Descrito(string campo, string id) => errosCampo.ContainsKey(campo) ? id : null;

    // Mensagem do campo inválido, ligada ao campo por aria-describedby.
    private RenderFragment MensagemDoCampo(string campo, string id) => builder =>
    {
        if (errosCampo.TryGetValue(campo, out var mensagem))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "status falha");
            builder.AddAttribute(2, "id", id);
            builder.AddAttribute(3, "role", "alert");
            builder.AddContent(4, mensagem);
            builder.CloseElement();
        }
    };

    private string? RotuloDoSmtp(MensagemVM mensagem) => mensagem.SmtpId is int id ? smtps.RotuloDe(id) : null;

    private string? NomeDoServidor(string? chave) =>
        grupos.SelectMany(g => g.Servidores).FirstOrDefault(s => string.Equals(s.Chave, chave, StringComparison.Ordinal))?.Nome ?? chave;

    private static PesquisarMailQueue.Query ParaQuery(FiltroMailQueueVM f) => new(f.Servidor, f.SmtpNumerico, f.Texto, f.Quantidade);

    private static string UrlDe(FiltroMailQueueVM f, string? sel) =>
        Navegacao.MailQueue(f.Servidor, f.SmtpNumerico, f.TextoAparado, f.QuantidadeNumerica, sel);

    // Mesma consulta = mesma chave: a URL que a própria página gravou não dispara a consulta de novo.
    private static string ChaveDe(FiltroMailQueueVM f) =>
        string.Join('\u001f', f.Servidor, f.Smtp?.Trim(), f.TextoAparado, f.QuantidadeNumerica?.ToString(CultureInfo.InvariantCulture) ?? f.Quantidade?.Trim());

    private static string? Vazio(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor;

    public void Dispose()
    {
        descartada = true;
        consultas?.Dispose();
        cancelamentoSmtps?.Cancel();
    }
}
