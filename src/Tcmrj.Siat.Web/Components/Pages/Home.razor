@page "/"
@attribute [Authorize]
@using Tcmrj.Siat.Web.Services
@inject IAutorizacaoConsultaService AutorizacaoConsulta

@* Página Início (.specs/features/pagina-home): atalhos para as ferramentas que o usuário pode usar, agrupados e na ordem
   do menu (lista única Ferramentas, AD-001); sem nenhuma, explica a quem pedir acesso. Não lê fonte de dados, por isso
   só exige autenticação (critério 8). *@
<CabecalhoPagina Titulo="Início" Descricao="Sistema Integrado de Apoio Técnico do TCMRio." />

@if (grupos is null)
{
    @* Permissões ainda em verificação: nem atalhos nem a mensagem de falta de acesso (critério 7). *@
}
else if (grupos.Count == 0)
{
    @if (situacaoVinculo is not null)
    {
        @* Sem matrícula não há permissão possível: o motivo é o cadastro no UserManager, não o grupo do SIAT. *@
        <AvisoVinculoDeRede Situacao="@situacaoVinculo" UsuarioDeRede="@usuarioDeRede" />
    }
    else
    {
        <div class="painel">
            <div class="estado">
                <h2>Você não tem acesso às ferramentas do SIAT</h2>
                <p>
                    Para usar o SIAT, peça acesso no SIA ao grupo <strong>Sistemas</strong> (catálogo e versões de sistemas)
                    ou ao grupo <strong>Consultas</strong> (MailQueue e AuditLog). Depois de liberado, recarregue a página.
                </p>
            </div>
        </div>
    }
}
else
{
    @foreach (var grupo in grupos)
    {
        var idTitulo = $"inicio-{grupo.Nome.ToLowerInvariant()}";
        <section class="inicio-grupo" aria-labelledby="@idTitulo">
            <h2 id="@idTitulo">@grupo.Nome</h2>
            <div class="painel telas">
                @foreach (var ferramenta in grupo.Ferramentas)
                {
                    <a href="@ferramenta.Rota" data-modulo="@ferramenta.Modulo.ToString()">
                        <strong>
                            <LucideIcon Name="@ferramenta.Icone" Size="17" aria-hidden="true" focusable="false" />
                            @ferramenta.Rotulo
                        </strong>
                        <span>@ferramenta.Descricao</span>
                    </a>
                }
            </div>
        </section>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoAutenticacao { get; set; }

    private IReadOnlyList<GrupoDeFerramentas>? grupos;
    private string? situacaoVinculo;
    private string? usuarioDeRede;

    protected override async Task OnInitializedAsync()
    {
        var permitidos = await Ferramentas.PermitidasAsync(AutorizacaoConsulta.PodeAcessarModuloAsync);

        if (permitidos.Count == 0 && EstadoAutenticacao is not null)
        {
            var usuario = (await EstadoAutenticacao).User;
            situacaoVinculo = VinculoDeRede.Situacao(usuario);
            usuarioDeRede = usuario.Identity?.Name;
        }

        grupos = permitidos;
    }
}
