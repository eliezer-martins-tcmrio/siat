@inject IWebHostEnvironment Ambiente

@* Marca no topo do menu, no padrão do SiCATI: sigla do TCMRio (positiva no claro, negativa no escuro, trocadas pelo
   siat.css conforme data-theme) e "SIAT" após um divisor fino; embaixo, o nome do sistema.
   Fora de produção, uma fita de borda a borda no topo do menu diz em que publicação do SIAT o usuário está
   (Development = desenvolvimento, vermelho; Staging = homologação, verde), na convenção dos outros sistemas do
   Tribunal. A fita é a única forma e o único lugar dessa informação: o ambiente do servidor consultado continua com a
   sigla em caixa (.amb) e a faixa de contexto, com as cores de ambiente (DESIGN.md, Publicação).
   Não alterar cores nem proporções do logo (DESIGN.md, Marca). *@
<div class="marca">
    @if (PublicacaoAtual() is var (chave, nome))
    {
        <p class="fita-publicacao" data-publicacao="@chave">@nome</p>
    }
    <a class="marca-link" href="" aria-label="SIAT, Sistema Integrado de Apoio Técnico do TCMRio. Ir para o início">
        <span class="marca-linha">
            <img class="logo-claro" src="img/tcmrio-sigla.png" width="109" height="20" alt="" />
            <img class="logo-escuro" src="img/tcmrio-sigla-negativo.png" width="109" height="20" alt="" />
            <span class="marca-sigla">SIAT</span>
        </span>
        <span class="marca-nome">Sistema Integrado de Apoio Técnico</span>
    </a>
</div>

@code {
    /// <summary>
    /// Publicação do SIAT, pelo <c>ASPNETCORE_ENVIRONMENT</c>, como no SiCATI. Em produção não mostra nada: a fita só
    /// serve para não confundir uma cópia de teste com a de produção.
    /// </summary>
    private (string Chave, string Nome)? PublicacaoAtual() =>
        Ambiente.IsDevelopment() ? ("dsv", "Desenvolvimento")
        : Ambiente.IsStaging() ? ("hml", "Homologação")
        : null;
}
