@using Tcmrj.Siat.App.Web.ViewModels.Copilot

@* Evolução diária do período (specs/005-copilot-meu-consumo, FR-017; research.md R11), em SVG próprio portado do
   usage-evolution.tsx do gestao-copilot: uma coluna por dia, seletor de métrica e visão por modelo (cinco modelos de
   maior total + "Outros"). Cada dia é um botão alcançável por teclado cujo aria-label é a alternativa em texto; acioná-lo
   filtra o período para aquele dia. Cores dos tokens do DESIGN.md (classes .serie-*). *@

<section class="painel evolucao" aria-labelledby="titulo-evolucao">
    <header>
        <h2 id="titulo-evolucao">Evolução diária</h2>
        <div class="empurra">
            <div class="segmentado" role="group" aria-label="Métrica">
                @foreach (var opcao in Metricas)
                {
                    <button type="button" aria-pressed="@(metrica == opcao ? "true" : "false")"
                            disabled="@(porModelo && opcao == MetricaDeConsumo.ValorLiquido)"
                            @onclick="() => metrica = opcao">@Rotulo(opcao)</button>
                }
            </div>
            <label class="alternar">
                <input type="checkbox" checked="@porModelo" @onchange="AlternarPorModelo" />
                Por modelo
            </label>
        </div>
    </header>

    <div class="grafico">
        <div class="colunas">
            @for (var i = 0; i < Dias.Count; i++)
            {
                var indice = i;
                var dia = Dias[indice];
                <button type="button" class="dia" @key="dia.Data" aria-label="@RotuloDoDia(indice)"
                        @onclick="() => AoEscolherDia.InvokeAsync(dia.Data)">
                    <svg viewBox="0 0 10 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        @if (porModelo)
                        {
                            var base_ = 100m;
                            @foreach (var serie in Series)
                            {
                                var altura = Altura(serie.Valores[indice]);
                                if (altura > 0)
                                {
                                    base_ -= altura;
                                    <rect class="@serie.Classe" x="0" y="@Numero(base_)" width="10" height="@Numero(altura)" />
                                }
                            }
                        }
                        else
                        {
                            var altura = Altura(metrica.De(dia.Consumo));
                            @if (altura > 0)
                            {
                                <rect x="0" y="@Numero(100 - altura)" width="10" height="@Numero(altura)" />
                            }
                        }
                    </svg>
                </button>
            }
        </div>
        @if (Dias.Count > 0)
        {
            <div class="eixo" aria-hidden="true">
                <span>@FormatoCopilot.Data(Dias[0].Data)</span>
                @if (Dias.Count > 2)
                {
                    <span>@FormatoCopilot.Data(Dias[Dias.Count / 2].Data)</span>
                }
                @if (Dias.Count > 1)
                {
                    <span>@FormatoCopilot.Data(Dias[^1].Data)</span>
                }
            </div>
        }
    </div>

    @if (porModelo && Series.Count > 0)
    {
        <div class="legenda-modelos">
            @foreach (var serie in Series)
            {
                <span @key="serie.Rotulo"><span class="marca @serie.Classe" aria-hidden="true"></span>@serie.Rotulo</span>
            }
        </div>
    }
</section>

@code {
    private static readonly MetricaDeConsumo[] Metricas = [MetricaDeConsumo.ValorBruto, MetricaDeConsumo.ValorLiquido, MetricaDeConsumo.Creditos];

    [Parameter, EditorRequired]
    public IReadOnlyList<DiaVM> Dias { get; set; } = [];

    /// <summary>Dia acionado (clique ou Enter): a página troca o período para ele.</summary>
    [Parameter]
    public EventCallback<DateOnly> AoEscolherDia { get; set; }

    private MetricaDeConsumo metrica = MetricaDeConsumo.ValorBruto;
    private bool porModelo;

    private IReadOnlyList<Serie> Series => SerieDeModelos.Montar(Dias, metrica);

    // Maior valor do dia (total, ou soma das séries) na métrica: topo do gráfico.
    private decimal Maximo => Dias.Count == 0 ? 0 : Dias.Max(d => metrica.De(d.Consumo));

    private decimal Altura(decimal valor) => Maximo <= 0 || valor <= 0 ? 0 : Math.Clamp(valor / Maximo * 100, 0, 100);

    private static string Numero(decimal valor) => valor.ToString("0.###", CultureInfo.InvariantCulture);

    private static string Rotulo(MetricaDeConsumo opcao) => opcao switch
    {
        MetricaDeConsumo.ValorLiquido => "Valor líquido",
        MetricaDeConsumo.Creditos => "Créditos",
        _ => "Valor bruto",
    };

    private void AlternarPorModelo(ChangeEventArgs e)
    {
        porModelo = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

        // A visão por modelo mostra valor bruto ou créditos (FR-017).
        if (porModelo && metrica == MetricaDeConsumo.ValorLiquido)
        {
            metrica = MetricaDeConsumo.ValorBruto;
        }
    }

    /// <summary>
    /// "27/11/2026, valor bruto US$ 1.23. Filtrar este dia." ou, por modelo, as séries com valor na ordem da legenda
    /// ("27/11/2026, valor bruto: GPT-5 US$ 0.80; Outros US$ 0.10. Filtrar este dia."); sem consumo, "sem consumo".
    /// </summary>
    private string RotuloDoDia(int indice)
    {
        var dia = Dias[indice];
        var data = FormatoCopilot.Data(dia.Data);
        if (!porModelo)
        {
            return $"{data}, {metrica.Rotulo()} {FormatoCopilot.Valor(metrica, metrica.De(dia.Consumo))}. Filtrar este dia.";
        }

        var partes = Series
            .Where(s => s.Valores[indice] > 0)
            .Select(s => $"{s.Rotulo} {FormatoCopilot.Valor(metrica, s.Valores[indice])}")
            .ToList();
        var valores = partes.Count == 0 ? "sem consumo" : string.Join("; ", partes);
        return $"{data}, {metrica.Rotulo()}: {valores}. Filtrar este dia.";
    }
}
