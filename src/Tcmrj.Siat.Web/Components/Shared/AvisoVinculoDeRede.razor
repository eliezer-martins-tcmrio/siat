@using Tcmrj.Siat.Web.Services

@* PROTÓTIPO (features/prototipo_login_rede): explica por que o usuário de rede ficou sem matrícula e, por isso,
   sem nenhuma permissão. Situação desconhecida não mostra nada. *@
@if (mensagem is { } m)
{
    <Aviso Variante="VarianteAviso.Erro" Titulo="@m.Titulo">@m.Texto</Aviso>
}

@code {
    /// <summary>Valor da claim <see cref="VinculoDeRede.TipoClaim"/>.</summary>
    [Parameter, EditorRequired]
    public string? Situacao { get; set; }

    /// <summary>Usuário de rede (<c>DOMINIO\login</c>), citado na mensagem.</summary>
    [Parameter]
    public string? UsuarioDeRede { get; set; }

    private (string Titulo, string Texto)? mensagem;

    protected override void OnParametersSet() => mensagem = Mensagem(Situacao, UsuarioDeRede);

    internal static (string Titulo, string Texto)? Mensagem(string? situacao, string? usuarioDeRede)
    {
        var usuario = string.IsNullOrWhiteSpace(usuarioDeRede) ? "o seu usuário de rede" : $"o usuário {usuarioDeRede}";

        return situacao switch
        {
            VinculoDeRede.DominioInvalido => (
                "Sua conta do Windows não é do domínio do Tribunal",
                $"O SIAT só aceita contas do domínio do Tribunal, e você entrou com {usuario}."),
            VinculoDeRede.NaoEncontrado => (
                "Seu usuário de rede não está ligado a uma matrícula",
                $"Não há matrícula ativa no cadastro do RH com {usuario} como login de rede. Peça a correção ao RH e, depois, recarregue a página."),
            VinculoDeRede.Duplicado => (
                "Seu usuário de rede está ligado a mais de uma matrícula",
                $"O cadastro do RH tem mais de uma matrícula ativa com {usuario} como login de rede. Por segurança, o SIAT não escolhe uma delas. Peça a correção ao RH."),
            VinculoDeRede.UsuarioDesabilitado => (
                "Sua matrícula não tem usuário habilitado no UserManager",
                "Peça a habilitação do seu usuário no UserManager e, depois, recarregue a página."),
            VinculoDeRede.Indisponivel => (
                "Não foi possível verificar o seu acesso agora",
                "O cadastro de usuários não respondeu. Recarregue a página em instantes."),
            _ => null,
        };
    }
}
