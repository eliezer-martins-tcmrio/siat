@using Tcmrj.Siat.App.Web.ViewModels.Catalogo

@* Célula de um ambiente na tabela de Sistemas (contracts/rotas-ui.md, Componente CelulaAmbiente): só envolve a
   ListaDeInstancias num td (specs/004-ficha-sistema), e o HTML gerado é o de antes. *@
<td><ListaDeInstancias Sistema="@Sistema" Ambiente="@Ambiente" /></td>

@code {
    /// <summary>Nome do sistema, para os nomes acessíveis dos botões de cópia.</summary>
    [Parameter, EditorRequired]
    public string Sistema { get; set; } = string.Empty;

    /// <summary>Ambiente (sigla, nome e instâncias).</summary>
    [Parameter, EditorRequired]
    public AmbienteVM Ambiente { get; set; } = default!;
}
